{
  "$schema": "https://json.schemastore.org/agentic-resources-1.0.0.json",
  "name": "tryx402 Agentic Resources",
  "domain": "tryx402.app",
  "version": "1.0.0",
  "description": "Agentic Resource Discovery (ARD) catalog for tryx402 governance tools and x402 endpoints.",
  "resources": [
    {
      "id": "llms-txt",
      "name": "LLM Summary Documentation",
      "type": "documentation",
      "url": "https://www.tryx402.app/llms.txt",
      "mimeType": "text/plain"
    },
    {
      "id": "llms-full",
      "name": "Complete Agent Integration Guide",
      "type": "documentation",
      "url": "https://www.tryx402.app/llms-full.txt",
      "mimeType": "text/plain"
    },
    {
      "id": "docs-portal",
      "name": "tryx402 Developer Documentation",
      "type": "documentation",
      "url": "https://www.tryx402.app/docs",
      "mimeType": "text/markdown"
    },
    {
      "id": "auth-guide",
      "name": "Agent Authentication Protocol (auth.md)",
      "type": "documentation",
      "url": "https://www.tryx402.app/auth.md",
      "mimeType": "text/markdown"
    },
    {
      "id": "openapi-spec",
      "name": "OpenAPI 3.1 Gateway Contract",
      "type": "api-schema",
      "url": "https://www.tryx402.app/openapi.json",
      "mimeType": "application/json"
    },
    {
      "id": "oauth-prm",
      "name": "OAuth 2.0 Protected Resource Metadata",
      "type": "api-schema",
      "url": "https://www.tryx402.app/.well-known/oauth-protected-resource",
      "mimeType": "application/json"
    },
    {
      "id": "oauth-as",
      "name": "OAuth 2.0 Authorization Server Metadata",
      "type": "api-schema",
      "url": "https://www.tryx402.app/.well-known/oauth-authorization-server",
      "mimeType": "application/json"
    },
    {
      "id": "pricing-catalog",
      "name": "Machine-Readable Pricing Catalog",
      "type": "pricing",
      "url": "https://www.tryx402.app/api/pricing",
      "mimeType": "application/json"
    },
    {
      "id": "mcp-server",
      "name": "tryx402 Zero-Dependency MCP Server",
      "type": "tool-server",
      "protocol": "mcp",
      "command": "python3 -m tryx402.mcp_server",
      "serverUrl": "https://www.tryx402.app/api/mcp",
      "serverCard": "https://www.tryx402.app/.well-known/mcp/server-card.json"
    }
  ]
}
